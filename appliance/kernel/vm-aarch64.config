# incus-spawn VM base image kernel: aarch64-only options.
# Concatenated last by build-kernel.sh vm, after vm.config. On arm64 CONFIG_EFI
# selects the EFI stub itself.

# ---- ACPI ----
# AAVMF hands the kernel ACPI tables, not a device tree, so PCI (MCFG), the
# console (SPCR, PL011 as ARMH0011) and the GIC are all found through ACPI.
CONFIG_ACPI=y

# ---- RTC ----
# QEMU/virt's ACPI tables do not describe the PL031, so the wall clock comes
# from the firmware's runtime services instead.
CONFIG_RTC_DRV_EFI=y

# ---- Built-in command line ----
# See vm-x86_64.config (CMDLINE_OVERRIDE). arm64 has no EXTEND or OVERRIDE, only FROM_BOOTLOADER or FORCE
# (isx.config); with no boot loader FORCE is the one that applies.
CONFIG_CMDLINE="root=PARTLABEL=isx-root rootfstype=ext4 rootwait ro console=ttyAMA0 loglevel=5 TERM=dumb"
CONFIG_CMDLINE_FORCE=y
