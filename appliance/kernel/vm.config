# incus-spawn VM base image kernel: options shared by both arches.
# build-kernel.sh vm concatenates isx.config, isx-<arch>.config, this file and
# vm-<arch>.config, in that order, so a vm fragment can override an appliance
# default. The appliance role never reads it.
#
# This kernel is the base VM image's own (#1255): OVMF/AAVMF load it straight
# from the ESP as EFI/BOOT/BOOTX64.EFI (BOOTAA64.EFI), with no boot loader, no
# initrd and no modules, and it mounts a Fedora root on virtio-blk. The command
# line is built in (vm-<arch>.config), since nothing else passes one.
#
# The rule: a feature goes in when a template asks for it. Deliberately absent:
#   - MODULES: the image ships no /lib/modules and nothing to load them from.
#   - device-mapper, XFS, squashfs, NVMe: the root is ext4 on virtio-blk.
#   - VFAT and NLS: the ESP is never mounted; the firmware reads it, not Linux.
#   - VT: the console is serial, and a VT measured nothing (isx.config).

# ---- Root filesystem: ext4 ----
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
# root=PARTLABEL= is resolved by the kernel itself, from the GPT partition
# name, so no initrd and no udev are needed to find the root.
CONFIG_EFI_PARTITION=y

# ---- EFI: the kernel is the EFI application the firmware starts ----
# The stub itself is arch-specific (vm-<arch>.config).
CONFIG_EFI=y

# systemd's proc-sys-fs-binfmt_misc.automount.
CONFIG_AUTOFS_FS=y

# ---- Nested virtualization: Incus VMs inside a --kvm branch ----
# The vendor KVM drivers are per-arch (vm-x86_64.config).
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y

# ---- Incus agent's config share ----
# Incus offers the agent's config drive over 9p and virtiofs; VIRTIO_FS is
# already in isx.config.
# 9P_FS sits under the network filesystems menu.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
